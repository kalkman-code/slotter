<ykit:DeskWindow x:Class="Snappy.PromptWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ykit="clr-namespace:Ykit"
                 Title="Snappy" Width="440" SizeToContent="Height" ResizeMode="NoResize"
                 ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Desk.CommitBar}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Desk.Button}" Margin="0,0,9,0" IsCancel="True"/>
        <Button x:Name="SaveButton" Content="Save name" Style="{StaticResource Desk.Button.Primary}" IsDefault="True"/>
      </StackPanel>
    </Border>
    <StackPanel Margin="22,20,22,8">
      <TextBlock x:Name="Prompt" Style="{StaticResource Desk.Text.InspectorHeading}"/>
      <TextBox x:Name="NameBox" Style="{StaticResource Desk.TextBox}" Margin="0,12,0,0" AutomationProperties.Name="Workspace name"/>
      <TextBlock x:Name="Error" Style="{StaticResource Desk.Text.Warning}" Margin="0,8,0,0" Visibility="Collapsed"/>
    </StackPanel>
  </DockPanel>
</ykit:DeskWindow>
