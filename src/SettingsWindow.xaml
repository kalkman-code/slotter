<ykit:DeskWindow x:Class="Snappy.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ykit="clr-namespace:Ykit"
                 xmlns:local="clr-namespace:Snappy"
                 Title="Snappy — Workspace Designer"
                 Width="1180" Height="880" MinWidth="920" MinHeight="640"
                 WindowStartupLocation="CenterScreen">

  <ykit:DeskWindow.Resources>
    <!-- The workspace list is Snappy-specific (a grouped, selectable list of named
         objects), so its look lives here rather than in the shared kit; every value
         is still a Desk token via DynamicResource. -->
    <Style x:Key="WorkspaceItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Cell" Background="Transparent" Padding="12,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Bar" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource FieldRaisedBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource FieldRaisedBrush}"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WorkspaceList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource WorkspaceItem}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <DataTemplate DataType="{x:Type local:WorkspaceHeader}">
      <TextBlock Text="{Binding Label}" Style="{StaticResource Desk.Text.Eyebrow}" Margin="0,14,0,6"
                 AutomationProperties.Name="{Binding Label}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:Profile}">
      <Grid Height="36" AutomationProperties.Name="{Binding Name}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                   VerticalAlignment="Center" Foreground="{DynamicResource InkSecondaryBrush}"/>
        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Style="{StaticResource Desk.Text}"/>
      </Grid>
    </DataTemplate>
  </ykit:DeskWindow.Resources>

  <DockPanel>

    <!-- Head: what this window is, one sentence of orientation, shortcut status. -->
    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" Padding="22,18,22,14"
            BorderBrush="{DynamicResource RuleBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Workspace designer" Style="{StaticResource Desk.Text.Heading}"/>
          <TextBlock Text="Arrange apps once, then launch the whole desk from the tray." Style="{StaticResource Desk.Text.Secondary}" Margin="0,3,0,0"/>
        </StackPanel>
        <Border x:Name="ShortcutPill" Grid.Column="2" Style="{StaticResource Desk.Tag}" VerticalAlignment="Center">
          <TextBlock x:Name="ShortcutText" Style="{StaticResource Desk.Tag.Text}"/>
        </Border>
      </Grid>
    </Border>

    <!-- Commit bar: never scrolls away, says what changed. -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Desk.CommitBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="CommitMessage" Text="Changes apply when you save." VerticalAlignment="Center" Margin="0,0,16,0"
                   Style="{StaticResource Desk.Text.Secondary}"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Desk.Button}" Margin="0,0,9,0"/>
          <Button x:Name="SaveButton" Content="Save changes" Style="{StaticResource Desk.Button.Primary}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Left: workspace list and the two app-wide preferences. -->
    <Border DockPanel.Dock="Left" Width="280" BorderThickness="0,0,1,0"
            Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource RuleBrush}">
      <DockPanel Margin="16,14,16,14">
        <ykit:DeskEyebrow DockPanel.Dock="Top" Content="Workspaces" Margin="0,0,0,8"/>

        <StackPanel DockPanel.Dock="Bottom">
          <Rectangle Height="1" Fill="{DynamicResource RuleBrush}" Margin="0,14,0,14"/>
          <ykit:DeskEyebrow Content="App settings" Margin="0,0,0,10"/>
          <CheckBox x:Name="StartupCheck" Style="{StaticResource Desk.CheckBox}" Margin="0,0,0,10">
            <TextBlock Text="Start with Windows" TextWrapping="Wrap"/>
          </CheckBox>
          <CheckBox x:Name="HotkeyCheck" Style="{StaticResource Desk.CheckBox}">
            <TextBlock Text="Global launch shortcut" TextWrapping="Wrap"/>
          </CheckBox>

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="AddButton" Grid.Column="0" Content="Add" Style="{StaticResource Desk.Button}" Margin="0,0,6,0"/>
            <Button x:Name="RenameButton" Grid.Column="1" Content="Rename" Style="{StaticResource Desk.Button}" Margin="0,0,6,0"/>
            <Button x:Name="RemoveButton" Grid.Column="2" Content="Remove" Style="{StaticResource Desk.Button}"/>
          </Grid>
        </StackPanel>

        <ListBox x:Name="WorkspaceList" Style="{StaticResource WorkspaceList}" DockPanel.Dock="Top"/>
      </DockPanel>
    </Border>

    <ScrollViewer x:Name="BodyScroll" Style="{StaticResource Desk.ScrollViewer}">
      <StackPanel x:Name="Body" Margin="22,14,22,16">

        <ykit:DeskEyebrow Content="Arrangement" Margin="0,0,0,8"/>
        <Border Style="{StaticResource Desk.Panel}" Padding="14">
          <local:ZoneCanvas x:Name="Canvas" Height="380"/>
        </Border>

        <ykit:DeskEyebrow Content="Selected zone"/>
        <ContentControl x:Name="Inspector" Style="{StaticResource Desk.Inspector}" Focusable="False" HorizontalContentAlignment="Stretch">
          <StackPanel>
            <TextBlock x:Name="SelLabel" Style="{StaticResource Desk.Text.InspectorHeading}"/>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="SplitVButton" Grid.Column="0" Content="Split &#x2502; vertical" Style="{StaticResource Desk.Button}" Margin="0,0,6,0"/>
              <Button x:Name="SplitHButton" Grid.Column="1" Content="Split &#x2500; horizontal" Style="{StaticResource Desk.Button}" Margin="6,0,0,0"/>
            </Grid>

            <TextBlock Text="Layout preset" Style="{StaticResource Desk.Text.CardHeading}" Margin="0,20,0,10"/>
            <ComboBox x:Name="PresetBox" Style="{StaticResource Desk.ComboBox}" AutomationProperties.Name="Layout preset"/>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="DeleteButton" Grid.Column="0" Content="Delete zone" Style="{StaticResource Desk.Button}" Margin="0,0,6,0"/>
              <Button x:Name="ResetButton" Grid.Column="1" Content="Reset monitor" Style="{StaticResource Desk.Button}" Margin="6,0,0,0"/>
            </Grid>

            <TextBlock Text="Position and size" Style="{StaticResource Desk.Text.CardHeading}" Margin="0,20,0,10"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="Left" Style="{StaticResource Desk.Text.Tertiary}" Margin="0,0,0,4"/>
                <TextBox x:Name="LeftBox" Style="{StaticResource Desk.TextBox}" AutomationProperties.Name="Left percent"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0">
                <TextBlock Text="Top" Style="{StaticResource Desk.Text.Tertiary}" Margin="0,0,0,4"/>
                <TextBox x:Name="TopBox" Style="{StaticResource Desk.TextBox}" AutomationProperties.Name="Top percent"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="6,0">
                <TextBlock Text="Width" Style="{StaticResource Desk.Text.Tertiary}" Margin="0,0,0,4"/>
                <TextBox x:Name="WidthBox" Style="{StaticResource Desk.TextBox}" AutomationProperties.Name="Width percent"/>
              </StackPanel>
              <StackPanel Grid.Column="3" Margin="6,0,0,0">
                <TextBlock Text="Height" Style="{StaticResource Desk.Text.Tertiary}" Margin="0,0,0,4"/>
                <TextBox x:Name="HeightBox" Style="{StaticResource Desk.TextBox}" AutomationProperties.Name="Height percent"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="App in this zone" Style="{StaticResource Desk.Text.CardHeading}" Margin="0,20,0,10"/>
            <ComboBox x:Name="ProgBox" Style="{StaticResource Desk.ComboBox}" AutomationProperties.Name="App assigned to selected zone"/>
            <Button x:Name="ManageButton" Content="Manage programs…" Style="{StaticResource Desk.Button}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
          </StackPanel>
        </ContentControl>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</ykit:DeskWindow>
