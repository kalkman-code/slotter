<ykit:DeskWindow x:Class="Snappy.ProgramsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ykit="clr-namespace:Ykit"
                 Title="Snappy — Programs"
                 Width="780" Height="560" MinWidth="560" MinHeight="380"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <ykit:DeskWindow.Resources>
    <Style x:Key="ProgramRow" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Cell" Background="Transparent" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1" Padding="12,10">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource FieldRaisedBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource FieldRaisedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </ykit:DeskWindow.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" Padding="22,18,22,14" BorderBrush="{DynamicResource RuleBrush}">
      <StackPanel>
        <TextBlock Text="Programs" Style="{StaticResource Desk.Text.Heading}"/>
        <TextBlock Text="Define an app once. Every workspace that uses it stays in sync." Style="{StaticResource Desk.Text.Secondary}" Margin="0,3,0,0"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Style="{StaticResource Desk.CommitBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="AddButton" Content="Add program" Style="{StaticResource Desk.Button}" Margin="0,0,9,0"/>
          <Button x:Name="EditButton" Content="Edit" Style="{StaticResource Desk.Button}" Margin="0,0,9,0"/>
          <Button x:Name="RemoveButton" Content="Remove" Style="{StaticResource Desk.Button}"/>
        </StackPanel>
        <Button x:Name="DoneButton" Grid.Column="1" Content="Done" Style="{StaticResource Desk.Button.Primary}"/>
      </Grid>
    </Border>

    <Grid Margin="22,14,22,16">
      <ListBox x:Name="ProgramList" BorderThickness="1"
               BorderBrush="{DynamicResource RuleBrush}" Background="{DynamicResource PanelBrush}"
               AutomationProperties.Name="Programs">
        <ListBox.ItemContainerStyle>
          <StaticResource ResourceKey="ProgramRow"/>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid AutomationProperties.Name="{Binding Name}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" Style="{StaticResource Desk.Text}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="1" Text="{Binding Exe}" Margin="10,0" Style="{StaticResource Desk.Text.Mono}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="2" Text="{Binding Args}" Style="{StaticResource Desk.Text.Tertiary}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyText" Text="No programs yet. Choose Add program to define one." Style="{StaticResource Desk.Text.Tertiary}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
  </DockPanel>
</ykit:DeskWindow>
