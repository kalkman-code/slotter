<Project>
  <!-- Build output lives outside the repo. The hub is a Syncthing share, and a
       versioned copy of Slotter.exe in .stversions is what a startup shortcut could
       end up pointing at. Nothing built may stay here. -->
  <PropertyGroup>
    <BaseOutputPath>$(LOCALAPPDATA)\Slotter-build\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(LOCALAPPDATA)\Slotter-build\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
